# Auth mode: "dev" skips login (app bypasses auth), "standard" uses credentials below
AUTH_MODE=standard

# Application URLs
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Admin credentials
ADMIN_USER=admin@example.com
ADMIN_PASS=admin123

# Standard test user credentials
TEST_USER=user@example.com
TEST_PASS=user123

# Database connection
DB_CONNECTION=postgresql://user:password@localhost:5432/testdb

# Browser configuration
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=10000

# Viewport
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Reporting
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=off
TRACE_RECORDING=off
