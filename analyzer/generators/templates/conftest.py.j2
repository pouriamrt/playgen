# ── API client fixture ───────────────────────────────────────────────────


@pytest.fixture(scope="session")
def api_client(request) -> Generator[APIClient, None, None]:
    """Provide an API client.

    Uses API_TEST_URL env var if set (for separate backend),
    otherwise falls back to --base-url passed to pytest.
    """
    url = os.environ.get("API_TEST_URL") or getattr(
        request.config.option, "base_url", None
    ) or "http://localhost:3000"
    client = APIClient(base_url=url)
    yield client
    client.session.close()
